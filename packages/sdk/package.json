{
  "name": "@orionis/sdk",
  "version": "0.1.0",
  "type": "module",
  "description": "Orionis Markets typed client \u2014 the only sanctioned way to talk to contracts/API from any frontend or integrator.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsup",
    "lint": "echo \"scaffold: packages/sdk lint \u2014 Phase 3\" && exit 0",
    "test": "tsx --test src/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "generate:abis": "node scripts/generate-abis.mjs",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "dependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "tsup": "^8",
    "@orionis/config": "workspace:*",
    "@orionis/types": "workspace:*"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      }
    },
    "access": "public"
  },
  "sideEffects": false,
  "license": "MIT",
  "author": "RubenDev",
  "homepage": "https://github.com/rubengitdev/orionis/tree/main/packages/sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rubengitdev/orionis.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/rubengitdev/orionis/issues"
  },
  "keywords": [
    "orionis",
    "derivatives",
    "options",
    "perpetuals",
    "tokenized-equities",
    "viem",
    "robinhood-chain"
  ],
  "engines": {
    "node": ">=20"
  }
}
