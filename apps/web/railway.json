{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @alphamarkets/web build",
    "watchPatterns": [
      "/apps/web/**",
      "/packages/**",
      "/pnpm-lock.yaml",
      "/package.json"
    ]
  },
  "deploy": {
    "startCommand": "pnpm --filter @alphamarkets/web start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "healthcheckPath": "/",
    "healthcheckTimeout": 60
  }
}
