# AlphaMarkets — environment configuration
# No chain config, contract addresses, or protocol token values are ever hardcoded in code.
# Copy this file to .env and fill in per environment (testnet / mainnet).

# --- Chain (Robinhood Chain) ---
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_RPC_URL=
# Optional. The API's caching read proxy, e.g. https://<api-host>/v1/rpc. Browser reads go here so many
# visitors share one upstream RPC call. NEXT_PUBLIC_RPC_URL stays the wallet's RPC. Needs the API's
# CORS_ORIGINS to include the web app's origin.
NEXT_PUBLIC_RPC_PROXY_URL=
NEXT_PUBLIC_EXPLORER_URL=

# Public origin of the web app, used for absolute social preview URLs. Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# --- Core contracts ---
NEXT_PUBLIC_MARKET_REGISTRY=
NEXT_PUBLIC_ALPHAMARKETS_VAULT=
NEXT_PUBLIC_OPTIONS_ENGINE=
NEXT_PUBLIC_PERPS_ENGINE=
NEXT_PUBLIC_ORACLE_ROUTER=
NEXT_PUBLIC_RISK_MANAGER=
NEXT_PUBLIC_FEE_MANAGER=

# --- Collateral ---
NEXT_PUBLIC_COLLATERAL_TOKEN=

# --- Protocol token (rebrand-safe: never hardcode a ticker or address) ---
NEXT_PUBLIC_PROTOCOL_TOKEN_SYMBOL=
NEXT_PUBLIC_PROTOCOL_TOKEN_ADDRESS=

# JSON object of contract addresses that replace the checked-in deployment for those contracts only,
# e.g. {"optionsEngine":"0x..."} after a redeploy. Read by the SDK, so every backend service
# picks it up. Keys are the ContractAddresses names in packages/config/src/deployments.ts.
ALPHAMARKETS_ADDRESSES=

# --- Backend services (Phase 2: services/indexer, services/pricing, services/risk-monitor, services/api) ---
# Server-side only — no NEXT_PUBLIC_ prefix, never bundled into client JS.
# Tests only: a scratch PostgreSQL that already has the indexer's schema (its tables are emptied),
# and a switch to skip the Anvil integration tests.
# TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5432/alphamarkets_test
# SKIP_ANVIL_TESTS=

# Chain the services run against: a chain with a deployment in packages/config. Unset means the
# recorded testnet. The web app reads NEXT_PUBLIC_CHAIN_ID instead.
CHAIN_ID=
RPC_URL=
DATABASE_URL=
API_PORT=4000
PRICING_PORT=4100
# services/api's proxy target for POST /v1/options/quote — defaults to PRICING_PORT above.
PRICING_SERVICE_URL=http://localhost:4100
PRICING_REQUEST_TIMEOUT_MS=10000

# Poll/tick intervals (all optional, defaults shown)
# Block to start indexing from when the database is empty: the block the contracts were deployed in
# (see packages/contracts/CHANGELOG.md), so that a new database replays the whole history and fills
# in the events the app reads. Unset starts at the chain head. Markets are always read from the registry.
INDEXER_START_BLOCK=
INDEXER_POLL_INTERVAL_MS=5000
# eth_getLogs range per call. 10 fits the Alchemy free tier; use about 2000 on the official Robinhood
# testnet RPC (https://rpc.testnet.chain.robinhood.com), which only caps a query at 10000 matched logs.
INDEXER_MAX_BLOCK_RANGE=10
RISK_MONITOR_POLL_INTERVAL_MS=10000
# risk-monitor flags a position as a liquidation candidate once its margin ratio is within
# this many bps above its market's actual maintenance margin rate (not a flat cutoff).
RISK_CANDIDATE_BUFFER_BPS=200
WS_TICK_MS=5000
# services/indexer records each active market's index price for price history and 24h change.
PRICE_SAMPLE_INTERVAL_MS=60000
PRICE_TICK_RETENTION_DAYS=8
# Origins allowed to call services/api from a browser (comma-separated, no wildcard). Set this to
# the deployed frontend URL; the default only covers the local Next.js dev server.
CORS_ORIGINS=http://localhost:3000

# Signs the option premiums the chain accepts (OptionsEngine QUOTER_ROLE). This is a critical secret:
# whoever holds it can set option prices. Server-side only; use a dedicated key, never the
# deployer's, and hold the role behind a multisig/HSM before mainnet. QUOTER_ADDRESS is the matching
# address, granted the role by script/DeployAll.s.sol. Without the key, /quote returns analytics only.
QUOTER_PRIVATE_KEY=
QUOTER_ADDRESS=
# How long a signed quote stays valid (seconds). Keep it short.
QUOTE_TTL_SECONDS=30

# Options pricing placeholders (services/pricing) — not a product decision, see
# services/pricing/src/blackScholes.ts. Flat assumed volatility (bps) and risk-free rate (bps).
DEFAULT_IV_BPS=5000
RISK_FREE_RATE_BPS=0
# Full bid-ask spread on option quotes, in bps of the mark, split evenly around it: opening pays the
# ask, closing receives the bid. 0 keeps bid = mark = ask. A placeholder until product sets one.
OPTION_SPREAD_BPS=0
# Shape of the volatility surface around the base volatility (services/pricing/src/surface.ts). All 0
# keeps the surface flat. It is the pricing MODEL's surface, not a market-implied one. Placeholders
# until product sets a skew.
#   VOL_SKEW_SLOPE: change in volatility per unit of ln(strike / spot); negative prices low strikes higher.
#   VOL_SMILE_CURVE: extra volatility per unit of squared log-moneyness.
#   VOL_TERM_SLOPE: change in volatility per unit of sqrt(years to expiry) away from 30 days.
VOL_SKEW_SLOPE=0
VOL_SMILE_CURVE=0
VOL_TERM_SLOPE=0
# Volatility is measured from the indexed index-price history (read from API_URL) when there are
# at least VOLATILITY_MIN_SAMPLES samples, clamped to [MIN, MAX] bps; otherwise DEFAULT_IV_BPS is used.
# This is realized volatility: there is no options market to imply one from.
API_URL=http://localhost:4000
VOLATILITY_HISTORY_RANGE=7d
VOLATILITY_MIN_SAMPLES=24
VOLATILITY_MIN_BPS=1000
VOLATILITY_MAX_BPS=30000
VOLATILITY_CACHE_SECONDS=300

# --- services/keeper ---
# Keeps the testnet mock price feeds fresh and fills limit orders whose trigger price is reached.
# The key needs gas. To refresh a mock feed it must also be that feed's owner: deploy the market
# with PRICE_FEED_OWNER=<keeper address> (script/ConfigureMarkets.s.sol). It holds no other role;
# filling an order is permissionless. Never reuse the deployer or quoter key.
KEEPER_PRIVATE_KEY=
KEEPER_INTERVAL_MS=15000
# Re-push a mock feed's price once its last update is this old (the oracle rejects prices older than 1h).
KEEPER_FEED_REFRESH_SECONDS=1800
# Set to false when a real price feed adapter replaces the mock feeds.
KEEPER_REFRESH_FEEDS=true

# --- Market makers (services/api RFQ and market maker API; contracts RFQManager) ---
# The address that signs RFQ quotes and holds MAKER_ROLE on RFQManager, granted by
# script/DeployAll.s.sol (default: the deployer, for local runs). A critical key: it sets the price of
# every RFQ trade. Use a dedicated key held by the market maker's own service.
MAKER_ADDRESS=
# API keys for market makers, as key:0xMakerAddress pairs, comma separated. Each key is at least 16
# characters. A quote is only accepted when it is signed by the address bound to the key that sent it.
# Empty means no market maker can connect.
MM_API_KEYS=
MM_RATE_PER_SECOND=20
MM_RATE_BURST=40

# --- services/hedger ---
# Keeps a wallet's options book delta neutral with perp positions. It only reports what it would do
# unless HEDGER_EXECUTE=true. The key needs gas and collateral in the Vault; use a dedicated key.
HEDGER_PRIVATE_KEY=
# Underlying symbol to hedge, e.g. NVDA. Every open perp on that market counts as part of the hedge.
HEDGER_MARKET=
HEDGER_INTERVAL_MS=60000
# Net delta to aim for and the band around it, in units of the underlying.
HEDGER_TARGET_DELTA=0
HEDGER_TOLERANCE_UNITS=1
# Skip a trade smaller than this (settlement-token base units), and the leverage for a new hedge (a market tier).
HEDGER_MIN_NOTIONAL=0
HEDGER_LEVERAGE=2
HEDGER_EXECUTE=false

# --- Frontend (apps/web) ---
# Base URL of services/api as the browser sees it (no trailing slash, no /v1). Optional: without it
# the terminal still trades perps, but options quotes, history and the live stream are unavailable.
NEXT_PUBLIC_API_URL=
# Any contract address above overrides the checked-in deployment in packages/config for that
# contract only; leave unset to use packages/config's record for NEXT_PUBLIC_CHAIN_ID. For a fresh
# deployment (e.g. local Anvil), also set the ones the section above does not list:
NEXT_PUBLIC_COLLATERAL_MANAGER=
NEXT_PUBLIC_OPTION_MARKET=
NEXT_PUBLIC_OPTION_POSITION_MANAGER=
NEXT_PUBLIC_PERP_POSITION_MANAGER=
# Limit orders: set once a deployment that includes PerpOrderManager is live (the terminal hides limit orders without it).
NEXT_PUBLIC_PERP_ORDER_MANAGER=
NEXT_PUBLIC_LIQUIDATION_ENGINE=
NEXT_PUBLIC_FUNDING_MANAGER=
NEXT_PUBLIC_PRICE_VALIDATOR=
NEXT_PUBLIC_BUYBACK_MODULE=

# --- Option chain layout (apps/web) ---
# The options contract lists no strikes (a series is created on first use), so the terminal proposes
# a ladder around the index price. Spacing is a percentage of spot in bps, rounded to a clean 1/2/5 step.
NEXT_PUBLIC_OPTION_STRIKE_STEP_BPS=500
# Strikes shown on each side of the one nearest spot.
NEXT_PUBLIC_OPTION_STRIKE_ROWS=5
# Proposed expiries, in days from today (comma-separated); series already opened on chain are added.
NEXT_PUBLIC_OPTION_EXPIRY_DAYS=7,14,30
# UTC hour of the day the proposed expiries settle.
NEXT_PUBLIC_OPTION_EXPIRY_HOUR_UTC=20
