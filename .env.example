# Orionis Markets — environment configuration
# No chain config, contract addresses, or protocol token values are ever hardcoded in code.
# Copy this file to .env and fill in per environment (testnet / mainnet).

# --- Chain (Robinhood Chain) ---
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_EXPLORER_URL=

# --- Core contracts ---
NEXT_PUBLIC_MARKET_REGISTRY=
NEXT_PUBLIC_ORIONIS_VAULT=
NEXT_PUBLIC_OPTIONS_ENGINE=
NEXT_PUBLIC_PERPS_ENGINE=
NEXT_PUBLIC_ORACLE_ROUTER=
NEXT_PUBLIC_RISK_MANAGER=
NEXT_PUBLIC_FEE_MANAGER=

# --- Collateral ---
NEXT_PUBLIC_COLLATERAL_TOKEN=

# --- Protocol token (rebrand-safe: never hardcode a ticker or address) ---
NEXT_PUBLIC_PROTOCOL_TOKEN_SYMBOL=
NEXT_PUBLIC_PROTOCOL_TOKEN_ADDRESS=

# --- Backend services (Phase 2: services/indexer, services/pricing, services/risk-monitor, services/api) ---
# Server-side only — no NEXT_PUBLIC_ prefix, never bundled into client JS.
RPC_URL=
DATABASE_URL=
API_PORT=4000
PRICING_PORT=4100
# services/api's proxy target for POST /v1/options/quote — defaults to PRICING_PORT above.
PRICING_SERVICE_URL=http://localhost:4100
PRICING_REQUEST_TIMEOUT_MS=10000

# Poll/tick intervals (all optional, defaults shown)
INDEXER_POLL_INTERVAL_MS=5000
# eth_getLogs range per call — this deploy's Alchemy free tier caps it at 10 (CHANGELOG [1.0.0-testnet]).
INDEXER_MAX_BLOCK_RANGE=10
RISK_MONITOR_POLL_INTERVAL_MS=10000
# risk-monitor flags a position as a liquidation candidate once its margin ratio is within
# this many bps above its market's actual maintenance margin rate (not a flat cutoff).
RISK_CANDIDATE_BUFFER_BPS=200
WS_TICK_MS=5000

# Options pricing placeholders (services/pricing) — not a product decision, see
# services/pricing/src/blackScholes.ts. Flat assumed volatility (bps) and risk-free rate (bps).
DEFAULT_IV_BPS=5000
RISK_FREE_RATE_BPS=0

# --- Frontend (apps/web) ---
# Base URL of services/api as the browser sees it (no trailing slash, no /v1). Optional: without it
# the terminal still trades perps, but options quotes, history and the live stream are unavailable.
NEXT_PUBLIC_API_URL=
# Any contract address above overrides the checked-in deployment in packages/config for that
# contract only; leave unset to use packages/config's record for NEXT_PUBLIC_CHAIN_ID. For a fresh
# deployment (e.g. local Anvil), also set the ones the section above does not list:
NEXT_PUBLIC_COLLATERAL_MANAGER=
NEXT_PUBLIC_OPTION_MARKET=
NEXT_PUBLIC_OPTION_POSITION_MANAGER=
NEXT_PUBLIC_PERP_POSITION_MANAGER=
NEXT_PUBLIC_LIQUIDATION_ENGINE=
NEXT_PUBLIC_FUNDING_MANAGER=
NEXT_PUBLIC_PRICE_VALIDATOR=
NEXT_PUBLIC_BUYBACK_MODULE=
