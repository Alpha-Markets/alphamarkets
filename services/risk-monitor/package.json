{
  "name": "@orionis/risk-monitor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Orionis Markets margin health watcher — read path only; liquidation execution stays onchain.",
  "scripts": {
    "build": "echo \"scaffold: services/risk-monitor build — Phase 2\" && exit 0",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "lint": "echo \"scaffold: services/risk-monitor lint — Phase 2\" && exit 0",
    "test": "tsx --test src/marginMath.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@orionis/config": "workspace:*",
    "@orionis/sdk": "workspace:*",
    "drizzle-orm": "^0.36.0",
    "postgres": "^3.4.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.28.0"
  }
}
