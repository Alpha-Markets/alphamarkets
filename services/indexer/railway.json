{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "true",
    "watchPatterns": [
      "/services/indexer/**",
      "/packages/**",
      "/pnpm-lock.yaml",
      "/package.json"
    ]
  },
  "deploy": {
    "startCommand": "pnpm --filter @alphamarkets/indexer start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "preDeployCommand": [
      "pnpm --filter @alphamarkets/indexer db:migrate"
    ]
  }
}
